{
  "name": "peposhots-starter-integrated-v1",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "check:assets": "node scripts/check-image-references.mjs",
    "test:responsive": "node --test tests/responsive.test.mjs",
    "test:journey": "node --test tests/shakerJourney.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:assets && npm run typecheck && npm run lint",
    "check:project": "node scripts/check-project-structure.mjs",
    "prebuild": "npm run check:project",
    "test:local": "node --test tests/local-improvements.test.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "typescript": "^5.8.0",
    "@types/nodemailer": "8.0.2",
    "react-test-renderer": "19.2.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
